{% doc %}
  Renders a custom Apple-style language or currency selector.

  Uses Shopify's {% form 'localization' %} for reliable locale switching.
  Features a custom non-native UI dropdown menu with generous arrow spacing, active checkmarks, and glassmorphic floating popovers.

  @param {string} type - "language" or "currency"
  @param {string} [position] - "header" or "footer"
  @param {string} [style] - "dropdown" or "inline"

  @example
  {% render 'locale-selector', type: 'language', position: 'header' %}
{% enddoc %}

{% liquid
  if type == 'language'
    assign label = 'general.locale.language_label' | t
    assign current = localization.language.iso_code
    assign current_name = localization.language.endonym_name
    assign param_name = 'language_code'
    assign options_source = localization.available_languages
  else
    assign label = 'general.locale.currency_label' | t
    assign current = localization.country.iso_code
    assign current_name = localization.country.currency.iso_code | append: ' (' | append: localization.country.currency.symbol | append: ')'
    assign param_name = 'country_code'
    assign options_source = localization.available_countries
  endif
%}

<div class="custom-locale-selector custom-locale-selector--{{ type }}" data-locale-type="{{ type }}">
  {%- form 'localization', class: 'custom-locale-form' -%}
    <input type="hidden" name="return_to" value="{{ request.path }}" data-return-to>
    <input type="hidden" name="{{ param_name }}" value="{{ current }}" data-custom-locale-input="{{ type }}">

    <div class="custom-dropdown" data-custom-dropdown="{{ type }}">
      <button type="button" class="custom-dropdown__trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="{{ label }}">
        <span class="custom-dropdown__current-label">{{ current_name }}</span>
        <svg class="custom-dropdown__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <ul class="custom-dropdown__list" role="listbox">
        {%- if type == 'language' -%}
          {%- for language in options_source -%}
            {%- assign is_selected = false -%}
            {%- if language.iso_code == current -%}{%- assign is_selected = true -%}{%- endif -%}
            <li class="custom-dropdown__item{% if is_selected %} is-active{% endif %}"
                data-value="{{ language.iso_code }}"
                role="option"
                aria-selected="{{ is_selected }}">
              <span class="custom-dropdown__item-text">{{ language.endonym_name }}</span>
              {%- if is_selected -%}
                <span class="custom-dropdown__checkmark">✓</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for country in options_source -%}
            {%- assign currency = country.currency -%}
            {%- assign is_selected = false -%}
            {%- if country.iso_code == current -%}{%- assign is_selected = true -%}{%- endif -%}
            <li class="custom-dropdown__item{% if is_selected %} is-active{% endif %}"
                data-value="{{ country.iso_code }}"
                role="option"
                aria-selected="{{ is_selected }}">
              <span class="custom-dropdown__item-text">{{ currency.iso_code }} ({{ currency.symbol }}) - {{ country.name }}</span>
              {%- if is_selected -%}
                <span class="custom-dropdown__checkmark">✓</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  {%- endform -%}
</div>

{% stylesheet %}
  .custom-locale-selector {
    position: relative;
    width: 100%;
    display: block;
  }

  .custom-locale-form {
    width: 100%;
    margin: 0;
  }

  .custom-dropdown {
    position: relative;
    width: 100%;
  }

  /* Custom Apple-Style Trigger Button */
  .custom-dropdown__trigger {
    width: 100%;
    height: 46px;
    padding: 0 42px 0 16px;
    border-radius: 12px;
    border: 1px solid #dcdce2;
    background-color: #ffffff;
    color: #111111;
    font-size: 0.92rem;
    font-weight: 600;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .custom-dropdown__trigger:hover {
    border-color: #000000;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .custom-dropdown__current-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-dropdown__chevron {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    transition: transform 0.25s ease;
    pointer-events: none;
    color: #666666;
  }

  .custom-dropdown.is-open .custom-dropdown__chevron {
    transform: translateY(-50%) rotate(180deg);
    color: #000000;
  }

  /* Custom Floating Popover List */
  .custom-dropdown__list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    right: 0;
    max-width: 100%;
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
    padding: 6px;
    margin: 0;
    list-style: none;
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    max-height: 260px;
    overflow-y: auto;
  }

  .custom-dropdown.is-open .custom-dropdown__list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .custom-dropdown__item {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #333333;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    margin-bottom: 2px;
  }

  .custom-dropdown__item:hover {
    background-color: #f2f2f7;
    color: #000000;
  }

  .custom-dropdown__item.is-active {
    background-color: #000000;
    color: #ffffff;
  }

  .custom-dropdown__checkmark {
    font-weight: 800;
    font-size: 0.95rem;
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var STORAGE_KEY = 'shop_locale_prefs';

    function savePrefs(language, currency) {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        var prefs = raw ? JSON.parse(raw) : {};
        if (language) prefs.language = language;
        if (currency) prefs.currency = currency;
        prefs.set_at = new Date().toISOString();
        localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
      } catch (e) {}
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Toggle dropdown open/close
      document.querySelectorAll('[data-custom-dropdown]').forEach(function(dropdown) {
        var trigger = dropdown.querySelector('.custom-dropdown__trigger');
        var hiddenInput = dropdown.closest('form').querySelector('[data-custom-locale-input]');
        var form = dropdown.closest('form');

        if (!trigger || !form) return;

        // Fix return_to
        var returnTo = form.querySelector('[data-return-to]');
        if (returnTo) {
          returnTo.value = window.location.pathname + window.location.search;
        }

        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();

          // Close all other dropdowns
          document.querySelectorAll('.custom-dropdown.is-open').forEach(function(other) {
            if (other !== dropdown) other.classList.remove('is-open');
          });

          dropdown.classList.toggle('is-open');
        });

        // Option click
        dropdown.querySelectorAll('.custom-dropdown__item').forEach(function(item) {
          item.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var val = item.getAttribute('data-value');
            var type = hiddenInput ? hiddenInput.getAttribute('data-custom-locale-input') : null;

            if (hiddenInput) hiddenInput.value = val;

            if (type === 'language') savePrefs(val, null);
            if (type === 'currency') savePrefs(null, val);

            dropdown.classList.remove('is-open');
            form.submit();
          });
        });
      });

      // Close dropdowns on outside click
      document.addEventListener('click', function() {
        document.querySelectorAll('.custom-dropdown.is-open').forEach(function(dropdown) {
          dropdown.classList.remove('is-open');
        });
      });
    });
  })();
{% endjavascript %}
