{% doc %}
  Renders the free shipping progress bar inside the Ajax cart drawer.

  @param {number} [threshold=100] - Free shipping threshold target in shop currency units (e.g. 100)
  @param {object} cart - The Shopify cart object

  @example
  {% render 'cart-drawer-shipping-bar', threshold: section.settings.free_shipping_threshold, cart: cart %}
{% enddoc %}

{%- liquid
  assign threshold_cents = threshold | default: 100 | times: 100
  assign current_total = cart.total_price
  assign remaining_cents = threshold_cents | minus: current_total
  
  if current_total >= threshold_cents
    assign is_unlocked = true
    assign percentage = 100
  else
    assign is_unlocked = false
    assign percentage = current_total | times: 100.0 | divided_by: threshold_cents | round
  endif
-%}

<div class="cart-drawer__shipping-bar{% if is_unlocked %} is-unlocked{% endif %}"
     data-threshold-cents="{{ threshold_cents }}"
     data-cart-total-cents="{{ current_total }}">
  <div class="cart-drawer__shipping-message">
    {%- if is_unlocked -%}
      <span class="shipping-message__text shipping-message__unlocked">
        🎉 {{ 'cart.drawer.free_shipping_unlocked' | t }}
      </span>
    {%- else -%}
      {%- assign remaining_money = remaining_cents | money -%}
      <span class="shipping-message__text">
        {{ 'cart.drawer.free_shipping_progress_html' | t: amount: remaining_money }}
      </span>
    {%- endif -%}
  </div>

  <div class="cart-drawer__shipping-progress-track">
    <div class="cart-drawer__shipping-progress-fill" style="width: {{ percentage }}%;"></div>
  </div>
</div>
