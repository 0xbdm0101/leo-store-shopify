{%- comment -%}
  Cart Drawer Section - Shopify Theme 2.0
  Self-contained Ajax cart drawer with free shipping progress bar and upsell recommendations.
{%- endcomment -%}

<div id="CartDrawer"
     class="cart-drawer"
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     aria-labelledby="CartDrawerTitle"
     style="--cart-drawer-width: 420px; --cart-drawer-accent-color: {{ settings.color_accent | default: '#000000' }};">
  
  {%- comment -%} Dark Overlay Background {%- endcomment -%}
  <div class="cart-drawer__overlay" data-action="close-cart-drawer"></div>

  {%- comment -%} Main Slide-out Panel {%- endcomment -%}
  <div class="cart-drawer__panel">
    
    {%- comment -%} Drawer Header {%- endcomment -%}
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">
        {{ 'cart.drawer.title' | t }}
        <span class="cart-drawer__count-badge">({{ cart.item_count }})</span>
      </h2>
      
      <button type="button"
              class="cart-drawer__close-btn"
              data-action="close-cart-drawer"
              aria-label="{{ 'cart.drawer.close' | t }}">
        &times;
      </button>
    </div>

    {%- comment -%} Free Shipping Progress Bar {%- endcomment -%}
    {%- if section.settings.show_shipping_bar -%}
      {% render 'cart-drawer-shipping-bar', threshold: section.settings.free_shipping_threshold, cart: cart %}
    {%- endif -%}

    {%- comment -%} Scrollable Content Body {%- endcomment -%}
    <div class="cart-drawer__body">
      {%- if cart.item_count > 0 -%}
        <div class="cart-drawer__items">
          {%- for item in cart.items -%}
            {% render 'cart-drawer-item', item: item, item_index: forloop.index %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="cart-drawer__empty-state">
          <div class="cart-drawer__empty-icon">🛒</div>
          <p class="cart-drawer__empty-text">{{ 'cart.drawer.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="cart-drawer__continue-btn">
            {{ 'cart.drawer.continue_shopping' | t }}
          </a>
        </div>
      {%- endif -%}

      {%- comment -%} Upsell Recommendations Section {%- endcomment -%}
      {%- if section.settings.show_upsell and section.settings.upsell_collection != blank and cart.item_count > 0 -%}
        {%- assign upsell_collection = collections[section.settings.upsell_collection] -%}
        {%- if upsell_collection.products.size > 0 -%}
          <div class="cart-drawer__upsell-section">
            <h3 class="cart-drawer__upsell-heading">{{ 'cart.drawer.upsell_title' | t }}</h3>
            <div class="cart-drawer__upsell-list">
              {%- assign count = 0 -%}
              {%- for product in upsell_collection.products -%}
                {%- render 'cart-drawer-upsell', product: product, cart: cart -%}
                {%- assign count = count | plus: 1 -%}
                {%- if count >= 3 -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- comment -%} Drawer Footer (Subtotal & Checkout) {%- endcomment -%}
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal-row">
          <span class="cart-drawer__subtotal-label">{{ 'cart.drawer.subtotal' | t }}</span>
          <span class="cart-drawer__subtotal-price">{{ cart.total_price | money }}</span>
        </div>

        <p class="cart-drawer__tax-note">
          {{ 'cart.drawer.taxes_and_shipping_policy_at_checkout_html' | t }}
        </p>

        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          <button type="submit" name="checkout" class="cart-drawer__checkout-btn">
            🔒 {{ 'cart.checkout' | t }} &bull; {{ cart.total_price | money }}
          </button>
        </form>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: flex;
    justify-content: flex-end;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.3s ease, opacity 0.3s ease;
  }

  .cart-drawer[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }

  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .cart-drawer__panel {
    position: relative;
    width: 100%;
    max-width: var(--cart-drawer-width);
    height: 100%;
    background-color: #ffffff;
    box-shadow: -4px 0 25px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    z-index: 10;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-drawer[aria-hidden="false"] .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid #eeeeee;
  }

  .cart-drawer__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-drawer__count-badge {
    font-size: 0.9rem;
    color: #666666;
  }

  .cart-drawer__close-btn {
    background: none;
    border: none;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    color: #333333;
    padding: 4px;
    transition: color 0.2s ease;
  }

  .cart-drawer__close-btn:hover {
    color: #000000;
  }

  /* Free Shipping Progress Bar Styles */
  .cart-drawer__shipping-bar {
    padding: 14px 24px;
    background-color: #f9f9f9;
    border-bottom: 1px solid #eeeeee;
  }

  .cart-drawer__shipping-message {
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 8px;
    color: #333333;
  }

  .shipping-message__unlocked {
    color: #2e7d32;
    font-weight: 600;
  }

  .cart-drawer__shipping-progress-track {
    width: 100%;
    height: 8px;
    background-color: #e0e0e0;
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-drawer__shipping-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #4caf50, #2e7d32);
    border-radius: 4px;
    transition: width 0.4s ease;
  }

  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }

  /* Cart Line Item Styles */
  .cart-drawer-item {
    display: flex;
    gap: 16px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid #f0f0f0;
  }

  .cart-drawer-item__image-wrapper {
    width: 70px;
    height: 70px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .cart-drawer-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer-item__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cart-drawer-item__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    line-height: 1.3;
  }

  .cart-drawer-item__title:hover {
    text-decoration: underline;
  }

  .cart-drawer-item__variant-title {
    font-size: 0.8rem;
    color: #777777;
  }

  .cart-drawer-item__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
  }

  .cart-drawer-item__final-price {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .cart-drawer-item__original-price {
    color: #999999;
    font-size: 0.85rem;
    margin-right: 6px;
  }

  .cart-drawer-item__quantity-controls {
    display: flex;
    align-items: center;
    border: 1px solid #dddddd;
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-drawer-item__qty-btn {
    background: #f7f7f7;
    border: none;
    width: 28px;
    height: 28px;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer-item__qty-btn:hover {
    background: #e9e9e9;
  }

  .cart-drawer-item__qty-input {
    width: 32px;
    height: 28px;
    border: none;
    text-align: center;
    font-size: 0.85rem;
    -moz-appearance: textfield;
  }

  .cart-drawer-item__qty-input::-webkit-outer-spin-button,
  .cart-drawer-item__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-drawer-item__remove-btn {
    background: none;
    border: none;
    color: #e53935;
    font-size: 0.75rem;
    cursor: pointer;
    align-self: flex-start;
    padding: 0;
    margin-top: 4px;
  }

  /* Empty Cart State */
  .cart-drawer__empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 0;
    text-align: center;
  }

  .cart-drawer__empty-icon {
    font-size: 3.5rem;
    margin-bottom: 16px;
  }

  .cart-drawer__empty-text {
    font-size: 1.05rem;
    color: #666666;
    margin-bottom: 20px;
  }

  .cart-drawer__continue-btn {
    display: inline-block;
    padding: 10px 24px;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .cart-drawer__continue-btn:hover {
    background-color: #333333;
  }

  /* Upsell Section Styles */
  .cart-drawer__upsell-section {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px dashed #dddddd;
  }

  .cart-drawer__upsell-heading {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .cart-drawer__upsell-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-drawer-upsell-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background-color: #f9f9f9;
    border-radius: 6px;
  }

  .cart-drawer-upsell-card__image-wrapper {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-drawer-upsell-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer-upsell-card__info {
    flex: 1;
  }

  .cart-drawer-upsell-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    display: block;
  }

  .cart-drawer-upsell-card__price {
    font-size: 0.8rem;
    color: #555555;
    margin-top: 2px;
  }

  .cart-drawer-upsell-card__add-btn {
    padding: 6px 14px;
    background-color: #ffffff;
    border: 1px solid #000000;
    color: #000000;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cart-drawer-upsell-card__add-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  /* Drawer Footer Styles */
  .cart-drawer__footer {
    padding: 20px 24px;
    border-top: 1px solid #eeeeee;
    background-color: #ffffff;
  }

  .cart-drawer__subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .cart-drawer__tax-note {
    font-size: 0.8rem;
    color: #777777;
    margin: 0 0 16px 0;
  }

  .cart-drawer__checkout-btn {
    width: 100%;
    padding: 14px;
    background-color: var(--cart-drawer-accent-color, #000000);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .cart-drawer__checkout-btn:hover {
    opacity: 0.9;
  }

  @media (max-width: 480px) {
    .cart-drawer__panel {
      max-width: 100vw;
    }
  }
{% endstylesheet %}

{% javascript %}
  const routes = {
    add: (window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'cart/add.js',
    change: (window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'cart/change.js',
    cart: (window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'cart.js'
  };

  class CartDrawerController {
    constructor() {
      this.drawer = document.getElementById('CartDrawer');
      if (!this.drawer) return;

      this.initEvents();
    }

    initEvents() {
      // Event delegation for opening & closing
      document.addEventListener('click', (e) => {
        const target = e.target.closest('[data-action]');
        if (!target) return;

        const action = target.dataset.action;
        if (action === 'open-cart-drawer') {
          e.preventDefault();
          this.open();
        } else if (action === 'close-cart-drawer') {
          e.preventDefault();
          this.close();
        } else if (action === 'decrement' || action === 'increment') {
          this.handleQuantityChange(target, action);
        } else if (action === 'remove') {
          this.handleRemove(target);
        } else if (action === 'add-upsell') {
          this.handleAddUpsell(target);
        }
      });

      // Keyboard accessibility - Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen()) {
          this.close();
        }
      });

      // Intercept any product "Add to Cart" forms on the page (use capture phase)
      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!form) return;

        const actionAttr = form.getAttribute('action') || '';
        const actionProp = form.action || '';

        if (actionAttr.includes('/cart/add') || actionProp.includes('/cart/add') || form.querySelector('[name="add"]')) {
          e.preventDefault();
          e.stopPropagation();
          this.handleFormAddToCart(form);
        }
      }, true);
    }

    isOpen() {
      return this.drawer.getAttribute('aria-hidden') === 'false';
    }

    open() {
      this.drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    close() {
      this.drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    getApiUrl(endpoint) {
      const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      const cleanRoot = root.endsWith('/') ? root : root + '/';
      return cleanRoot + 'cart/' + endpoint + '.js';
    }

    async handleFormAddToCart(form) {
      try {
        const formData = new FormData(form);
        formData.append('sections', 'cart-drawer');

        const response = await fetch(this.getApiUrl('add'), {
          method: 'POST',
          body: formData
        });

        if (response.ok) {
          const data = await response.json();
          this.renderSection(data.sections['cart-drawer']);
          this.open();
        } else {
          // Fallback if section rendering is not returned
          await this.refreshDrawer();
          this.open();
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
      }
    }

    async handleQuantityChange(button, action) {
      const input = button.parentElement.querySelector('.cart-drawer-item__qty-input');
      if (!input) return;

      const currentQty = parseInt(input.value, 10) || 0;
      const newQty = action === 'increment' ? currentQty + 1 : Math.max(0, currentQty - 1);
      const key = input.dataset.key;

      await this.updateCartItem(key, newQty);
    }

    async handleRemove(button) {
      const key = button.dataset.key;
      if (key) {
        await this.updateCartItem(key, 0);
      }
    }

    async handleAddUpsell(button) {
      const variantId = button.dataset.variantId;
      if (!variantId) return;

      button.disabled = true;
      button.textContent = 'Adding...';

      try {
        const response = await fetch(this.getApiUrl('add'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [{ id: parseInt(variantId, 10), quantity: 1 }],
            sections: 'cart-drawer'
          })
        });

        if (response.ok) {
          const data = await response.json();
          this.renderSection(data.sections['cart-drawer']);
        }
      } catch (error) {
        console.error('Error adding upsell:', error);
      }
    }

    async updateCartItem(key, quantity) {
      try {
        const response = await fetch(this.getApiUrl('change'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: key,
            quantity: quantity,
            sections: 'cart-drawer'
          })
        });

        if (response.ok) {
          const data = await response.json();
          this.renderSection(data.sections['cart-drawer']);
        }
      } catch (error) {
        console.error('Error updating cart:', error);
      }
    }

    async refreshDrawer() {
      try {
        const response = await fetch(window.location.pathname + '?sections=cart-drawer');
        if (response.ok) {
          const data = await response.json();
          this.renderSection(data['cart-drawer']);
        }
      } catch (e) {
        console.error('Error refreshing drawer:', e);
      }
    }

    renderSection(html) {
      if (!html) return;
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newDrawerPanel = doc.querySelector('.cart-drawer__panel');
      const currentDrawerPanel = this.drawer.querySelector('.cart-drawer__panel');

      if (newDrawerPanel && currentDrawerPanel) {
        currentDrawerPanel.innerHTML = newDrawerPanel.innerHTML;
      }
    }
  }

  // Initialize on DOM Ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new CartDrawerController());
  } else {
    new CartDrawerController();
  }
{% endjavascript %}

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shipping_bar",
      "label": "Show free shipping progress bar",
      "default": true
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping goal ($)",
      "min": 10,
      "max": 500,
      "step": 10,
      "default": 100,
      "unit": "$"
    },
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "Show cart upsell recommendations",
      "default": true
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Upsell products collection"
    }
  ]
}
{% endschema %}
