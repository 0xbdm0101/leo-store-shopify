{% comment %}
  Welcome to Shopify theme development!
{% endcomment %}

<div
  class="hello-world"
  style="
    --hero-bg: {{ section.settings.hero_bg_color }};
    --hero-padding: {{ section.settings.hero_padding }}px;
    --card-bg: {{ section.settings.card_bg_color }};
    --card-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="welcome full-width">
    <div class="welcome-content">
    <div>
      <h1>{{ 'home.hero.title' | t }}</h1>

      <p class="welcome-description">
        {{ 'home.hero.description' | t }}
      </p>

      <p class="welcome-description">
        {{ 'home.hero.description2' | t }}
      </p>
    </div>

    {% if section.settings.show_icon %}
      <div class="icon">
        <img src="{{ 'shoppy-x-ray.svg' | asset_url }}" width="300" height="300" alt="">
      </div>
    {% endif %}
  </div>
</div>

<div class="highlights {{ section.settings.columns_desktop }}">
  <div class="highlight">
    <h3>{{ 'home.sections.key_concepts.title' | t }}</h3>
    <p class="highlight-description">
      {{ 'home.sections.key_concepts.description' | t }}
    </p>
    <p>{{ 'home.sections.key_concepts.link_text' | t | link_to: 'https://shopify.dev/docs/storefronts/themes/architecture' }}</p>
  </div>

  <div class="highlight">
    <h3>{{ 'home.sections.liquid.title' | t }}</h3>
    <p class="highlight-description">
      {{ 'home.sections.liquid.description' | t }}
    </p>
    <p>{{ 'home.sections.liquid.link_text' | t | link_to: 'https://shopify.dev/docs/api/liquid' }}</p>
  </div>

  <div class="highlight">
    <h3>{{ 'home.sections.best_practices.title' | t }}</h3>
    <p class="highlight-description">
      {{ 'home.sections.best_practices.description' | t }}
    </p>
    <p>{{ 'home.sections.best_practices.link_text' | t | link_to: 'https://shopify.dev/docs/storefronts/themes/best-practices' }}</p>
  </div>
</div>
</div>

{% stylesheet %}
  .welcome {
    display: grid;
    grid-template-columns: var(--content-grid);
    background-color: var(--hero-bg);
    padding: var(--hero-padding) 0;
  }

  .welcome-content {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0 24px;
  }

  .welcome-description {
    max-width: 80ch;
    line-height: 1.4;
    margin-top: 1.5rem;
  }

  .icon {
    width: 300px;
  }

  .highlights {
    display: grid;
    gap: 2rem;
    margin-top: 50px;
  }

  /* Multi-column layouts set by schema select */
  .highlights--3col {
    grid-template-columns: repeat(3, 1fr);
  }

  .highlights--2col {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 1100px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }

  .highlight {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
    color: rgb(92, 95, 98);
    line-height: 1.4;
  }

  .highlight > * + * {
    margin-top: 1rem;
  }

  .highlight h3 {
    font-size: 1rem;
    color: rgb(32, 34, 35);
  }

  .highlight-description {
    flex: 1 1;
  }

  .highlight a {
    display: flex;
    width: fit-content;
    background-color: rgb(250, 251, 251);
    box-shadow: rgba(0, 0, 0, 0.2) 0px -3px 0px 0px inset, rgba(255, 255, 255, 0.9) 0px 2px 0px 0px inset;
    border: 1px solid rgb(140, 145, 150);
    border-radius: 4px;
    color: rgb(92, 95, 98);
    padding: 3px 10px 5px;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hello_world",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.hero_section"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "t:labels.background",
      "default": "#f6f6f7"
    },
    {
      "type": "range",
      "id": "hero_padding",
      "label": "t:labels.padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:labels.show_icon",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.cards_section"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "t:labels.background",
      "default": "#eef3ff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:labels.rounded_corners",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "options": [
        { "value": "highlights--3col", "label": "t:options.columns.three" },
        { "value": "highlights--2col", "label": "t:options.columns.two" }
      ],
      "default": "highlights--3col"
    }
  ],
  "presets": [
    {
      "name": "t:general.hello_world",
      "category": "Demo"
    }
  ]
}
{% endschema %}
