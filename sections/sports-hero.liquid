{%- comment -%}
  Apple-Style Immersive Sports Hero Banner Section
  Features glassmorphic pill badges, rounded action buttons, gradient overlay, and CSS3 micro-interactions.
{%- endcomment -%}

<div class="sports-hero full-width" style="--hero-min-height: {{ section.settings.min_height }}px">
  <div class="sports-hero__bg-wrapper">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           alt="{{ section.settings.heading | escape }}"
           width="2000"
           height="1000"
           class="sports-hero__bg-image"
           loading="eager">
    {%- else -%}
      <div class="sports-hero__bg-placeholder"></div>
    {%- endif -%}
    <div class="sports-hero__overlay"></div>
  </div>

  <div class="sports-hero__content-container page-width">
    <div class="sports-hero__card-glass">
      {%- assign hero_badge = section.settings.badge_text -%}
      {%- if hero_badge == blank -%}
        {%- assign hero_badge = 'home.sports_hero.badge' | t -%}
      {%- endif -%}

      {%- assign hero_heading = section.settings.heading -%}
      {%- if hero_heading == blank -%}
        {%- assign hero_heading = 'home.sports_hero.title' | t -%}
      {%- endif -%}

      {%- assign hero_subheading = section.settings.subheading -%}
      {%- if hero_subheading == blank -%}
        {%- assign hero_subheading = 'home.sports_hero.subtitle' | t -%}
      {%- endif -%}

      {%- if hero_badge != blank -%}
        <div class="sports-hero__badge">
          <span class="sports-hero__badge-pulse"></span>
          {{ hero_badge | escape_once }}
        </div>
      {%- endif -%}

      <h1 class="sports-hero__heading">
        {{ hero_heading | escape_once }}
      </h1>

      <p class="sports-hero__subheading">
        {{ hero_subheading | escape_once }}
      </p>

      <div class="sports-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="sports-hero__btn sports-hero__btn--primary">
            {{ section.settings.button_label | escape_once }}
            <span class="sports-hero__btn-arrow">&rarr;</span>
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link | default: '#sports-categories' }}" class="sports-hero__btn sports-hero__btn--secondary">
            {{ section.settings.secondary_button_label | escape_once }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .sports-hero {
    position: relative;
    width: 100%;
    min-height: var(--hero-min-height, 620px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #ffffff;
    margin-bottom: 40px;
  }

  .sports-hero__bg-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .sports-hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.03);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sports-hero:hover .sports-hero__bg-image {
    transform: scale(1);
  }

  .sports-hero__bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
  }

  .sports-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.65) 100%);
  }

  .sports-hero__content-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-width, 1280px);
    margin-left: auto;
    margin-right: auto;
    padding-top: 60px;
    padding-bottom: 60px;
    padding-left: max(var(--page-margin, 24px), 24px);
    padding-right: max(var(--page-margin, 24px), 24px);
  }

  /* Apple Glassmorphic Main Card */
  .sports-hero__card-glass {
    max-width: 680px;
    background: rgba(18, 18, 18, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 28px;
    padding: 44px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }

  /* Glass Pill Badge */
  .sports-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .sports-hero__badge-pulse {
    width: 8px;
    height: 8px;
    background-color: #00ff88;
    border-radius: 50%;
    box-shadow: 0 0 10px #00ff88;
    animation: hero-pulse 2s infinite;
  }

  @keyframes hero-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(0, 255, 136, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 136, 0); }
  }

  .sports-hero__heading {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .sports-hero__subheading {
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 32px 0;
    font-weight: 400;
  }

  .sports-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Pill Buttons */
  .sports-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 30px;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sports-hero__btn--primary {
    background-color: #ffffff;
    color: #000000;
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.25);
  }

  .sports-hero__btn--primary:hover {
    transform: translateY(-3px);
    background-color: #f0f0f0;
    box-shadow: 0 12px 30px rgba(255, 255, 255, 0.35);
  }

  .sports-hero__btn-arrow {
    transition: transform 0.25s ease;
  }

  .sports-hero__btn--primary:hover .sports-hero__btn-arrow {
    transform: translateX(4px);
  }

  .sports-hero__btn--secondary {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .sports-hero__btn--secondary:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 768px) {
    .sports-hero {
      min-height: 520px;
    }
    .sports-hero__card-glass {
      padding: 28px 20px;
      border-radius: 20px;
    }
    .sports-hero__heading {
      font-size: 1.85rem;
    }
    .sports-hero__subheading {
      font-size: 0.95rem;
    }
    .sports-hero__actions {
      flex-direction: column;
    }
    .sports-hero__btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sports Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Pill Badge Text",
      "default": "2026 PRO ATHLETIC COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEYOND LIMITS · UNLEASH YOUR POTENTIAL"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover next-generation professional sports gear, precision-engineered badminton equipment, and performance apparel."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "EXPLORE PRO GEAR"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "VIEW CATEGORIES"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Banner Height (px)",
      "min": 400,
      "max": 800,
      "step": 20,
      "default": 620,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Sports Hero Banner"
    }
  ]
}
{% endschema %}
